{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "AllowedHosts": "*",
  "RegenerateThumbnails": false,
  "GalleryPath": "DemoGallery",
  "TempDir": "temp",
  "LogDir": ".",
  "MetaFile": "_meta.json",
  "Images": [ "jpg", "png" ],
  "Videos": [ "mp4" ],
  "MediaClipStart": 10,
  "MediaClipLength": 15,
  "Thumbnail": {
    "name": "thumbnail",
    "width": 260,
    "height": 260
  },
  "Icon": {
    "name": "icon",
    "width": 100,
    "height": 100
  }
}
